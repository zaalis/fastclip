# =============================================================================
# Fastclip - exemple de configuration
# Copie ce fichier vers backend/.env puis remplis les valeurs.
# Ce fichier NE contient aucune vraie cle. backend/.env n'est jamais versionne.
# =============================================================================

# --- Analyse IA (Mistral) ----------------------------------------------------
# Chaque utilisateur ajoute sa propre cle depuis Parametres > Connexion IA.
# Les cles ne doivent jamais etre placees dans ce fichier.
MISTRAL_MODEL=mistral-large-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_TIMEOUT_SECONDS=120

# --- Transcription (faster-whisper, CPU) -------------------------------------
# tiny | base | small | medium | large-v3
# Sur une e2-standard-2 (2 vCPU), "small" est le meilleur compromis.
# Utilise "tiny" pour un premier lancement rapide (modele ~75 Mo).
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_BEAM_SIZE=1
# Laisse vide pour la detection automatique de la langue.
WHISPER_LANGUAGE=

# --- Securite ----------------------------------------------------------------
# Genere une valeur aleatoire longue en production :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la valeur est vide, une cle est generee et stockee dans data/.secret_key
SECRET_KEY=
# Mettre a true derriere HTTPS (obligatoire en production).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Origines autorisees pour le front-end en developpement.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Limites d'import --------------------------------------------------------
MAX_UPLOAD_MB=250
MAX_DURATION_SECONDS=600
MAX_STORAGE_PER_USER_MB=2048
ALLOWED_EXTENSIONS=.mp4,.mov,.webm

# --- Retention ---------------------------------------------------------------
# Les fichiers sources et les exports sont supprimes apres ce delai.
RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=15

# --- Export video ------------------------------------------------------------
EXPORT_WIDTH=720
EXPORT_HEIGHT=1280
EXPORT_CRF=23
EXPORT_PRESET=veryfast
EXPORT_AUDIO_BITRATE=128k
FFMPEG_THREADS=2

# --- Binaires ----------------------------------------------------------------
# Laisse vide pour la detection automatique :
#   1. FFmpeg present dans le PATH
#   2. sinon, le binaire fourni par le paquet Python imageio-ffmpeg
FFMPEG_PATH=
FFPROBE_PATH=

# --- Limites de debit (par utilisateur, par heure) ---------------------------
RATE_LIMIT_UPLOADS_PER_HOUR=12
RATE_LIMIT_ANALYSES_PER_HOUR=30
RATE_LIMIT_EXPORTS_PER_HOUR=40

# --- Sessions ----------------------------------------------------------------
SESSION_DAYS=1
SESSION_DAYS_REMEMBER=30

# --- Mode test interne (NON-IA) ----------------------------------------------
# Quand un compte n'a pas encore de cle ET que cette option vaut true, Fastclip
# genere des propositions par une heuristique locale (densite de parole, rythme,
# duree cible). Ce n'est PAS de l'IA : chaque proposition est marquee
# "mode test local" dans l'interface et n'est jamais presentee comme une
# analyse IA. Reserve au developpement et aux tests.
FASTCLIP_ALLOW_HEURISTIC_FALLBACK=false

# --- Divers ------------------------------------------------------------------
ENVIRONMENT=development
# DATA_DIR=./data
