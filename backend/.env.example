# =============================================================================
# Fastclip - configuration example
# Copy this file to backend/.env and set the values needed for your deployment.
# This file never contains a real key, and backend/.env is never committed.
# =============================================================================

# --- AI analysis (Mistral) ---------------------------------------------------
# Each user connects their own key from Settings > AI connection.
# API keys must never be placed in this file.
MISTRAL_MODEL=mistral-large-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_TIMEOUT_SECONDS=120

# --- Transcription (faster-whisper, CPU/int8) --------------------------------
# tiny | base | small | medium | large-v3
# On a 2-vCPU e2-standard-2, "small" is a good quality/performance balance.
# Use "tiny" for a fast first launch (model size: about 75 MB).
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_BEAM_SIZE=1
# Leave empty for automatic language detection.
WHISPER_LANGUAGE=

# --- Security ----------------------------------------------------------------
# Generate a long random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, Fastclip generates and persists a key in data/.secret_key.
SECRET_KEY=
# Set to true only behind HTTPS (required for a secure production cookie).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Allowed frontend origins for development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Upload limits -----------------------------------------------------------
MAX_UPLOAD_MB=250
MAX_DURATION_SECONDS=600
MAX_STORAGE_PER_USER_MB=2048
ALLOWED_EXTENSIONS=.mp4,.mov,.webm

# --- Retention ---------------------------------------------------------------
# Source files and exports are deleted after this period.
RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=15

# --- Video export ------------------------------------------------------------
EXPORT_WIDTH=720
EXPORT_HEIGHT=1280
EXPORT_CRF=23
EXPORT_PRESET=veryfast
EXPORT_AUDIO_BITRATE=128k
FFMPEG_THREADS=2

# --- Binaries ----------------------------------------------------------------
# Leave empty for automatic discovery:
#   1. FFmpeg available on PATH
#   2. otherwise, the binary bundled with imageio-ffmpeg
FFMPEG_PATH=
FFPROBE_PATH=

# --- Per-user hourly rate limits ---------------------------------------------
RATE_LIMIT_UPLOADS_PER_HOUR=12
RATE_LIMIT_ANALYSES_PER_HOUR=30
RATE_LIMIT_EXPORTS_PER_HOUR=40

# --- Sessions ----------------------------------------------------------------
SESSION_DAYS=1
SESSION_DAYS_REMEMBER=30

# --- Internal non-AI test mode -----------------------------------------------
# When an account has not connected a Mistral key and this option is true,
# Fastclip creates suggestions with a local heuristic (speech density, pace,
# target duration, and segment independence). This is not AI: every result is
# labelled "local test mode" in the interface and is never presented as an AI
# analysis. Use it for development and testing only.
FASTCLIP_ALLOW_HEURISTIC_FALLBACK=false

# --- Other -------------------------------------------------------------------
ENVIRONMENT=development
# DATA_DIR=./data
